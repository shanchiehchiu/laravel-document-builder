{
    "name": "document-builder/document-builder",
    "description": "單據建置精靈：以 GrapesJS 視覺化設計單據表單，並提供填單、明細表、單號、狀態、版本審核與 MCP 介面",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "mcp/sdk": "^0.8.1",
        "nyholm/psr7": "^1.8",
        "symfony/psr-http-message-bridge": "^7.4",
        "yajra/laravel-datatables-oracle": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "DocumentBuilder\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DocumentBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DocumentBuilder\\DocumentBuilderServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
